# ClawTicker daemon config. Copy to ~/.config/clawticker/config.
# Re-read on every refresh, no restart needed (except port).

# What the board shows:
#   claude = one Claude screen
#   multi  = one screen with Claude and Codex side by side
display = claude

# Coins on the Coin screen, up to 4: <coingecko-id>:<SYMBOL>, comma separated.
# Ids are on each coin's CoinGecko page ("API ID").
coins = bitcoin:BTC
vs = usd

# Port the board connects to.
port = 8787

# Which Claude Code account to show. Empty = your default account (~/.claude).
# To show another one, point at its config dir, for example a work account:
# claude_config_dir = ~/.claude-work
claude_config_dir =
